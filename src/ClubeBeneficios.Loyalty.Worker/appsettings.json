{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ClubeBeneficiosDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "LoyaltyWorker": {
    "Enabled": true,
    "Mode": "Manual",
    "PollingIntervalSeconds": 60,
    "BatchSize": 500,
    "RunOnStartup": true,
    "RunType": "manual-worker",
    "CommandTimeoutSeconds": 180,
    "SqlApplicationLockName": "clube-beneficios-loyalty-processing",
    "EnablePointsExpiration": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
